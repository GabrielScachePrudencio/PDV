<Window x:Class="PDV_LANCHES.Views.ConfiguracaoServidor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuração de Conexão"
        Height="720" Width="450"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <SolidColorBrush x:Key="BgPrincipal" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="BgCard" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextoPrincipal" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextoSecundario" Color="#64748B"/>
        <SolidColorBrush x:Key="CorPrimaria" Color="#3B82F6"/>
        <SolidColorBrush x:Key="BordaPrincipal" Color="#E2E8F0"/>

        <Style x:Key="ModernInput" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="{StaticResource BordaPrincipal}" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnAcao" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BgPrincipal}"
            CornerRadius="20"
            BorderBrush="{StaticResource BordaPrincipal}"
            BorderThickness="1"
            MouseDown="Window_MouseDown">

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="35">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,30">
                    <Border Width="50" Height="50" Background="#DBEAFE" CornerRadius="25" HorizontalAlignment="Center" Margin="0,0,0,15">
                        <TextBlock Text="⚙" FontSize="24" Foreground="{StaticResource CorPrimaria}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="CONFIGURAÇÕES" HorizontalAlignment="Center" FontSize="11" FontWeight="Black" Foreground="{StaticResource CorPrimaria}" />
                </StackPanel>

                <Grid Grid.Row="1">

                    <StackPanel x:Name="ParteDaSenhaBasica" Visibility="Visible">
                        <TextBlock Text="Acesso Restrito" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextoPrincipal}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Digite a senha mestre para configurar as conexões do servidor." TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource TextoSecundario}" Margin="0,0,0,25"/>

                        <TextBlock Text="SENHA DE ACESSO" Foreground="{StaticResource TextoSecundario}" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                        <Border Background="#F1F5F9" CornerRadius="8" BorderBrush="{StaticResource BordaPrincipal}" BorderThickness="1" Margin="0,0,0,20">
                            <PasswordBox x:Name="senhabasica" Height="42" Background="Transparent" BorderThickness="0" Padding="12,0" VerticalContentAlignment="Center"/>
                        </Border>

                        <Button Content="Continuar" Background="{StaticResource CorPrimaria}" Foreground="White" Style="{StaticResource BtnAcao}" Click="validaSenhaBasica_Click"/>
                    </StackPanel>

                    <StackPanel x:Name="ConfiguracaoPara" Visibility="Hidden">

                        <Border Background="#EFF6FF" Padding="15" CornerRadius="10" Margin="0,0,0,25">
                            <TextBlock Text="Defina abaixo os endereços de API e Banco de Dados." Foreground="#1E40AF" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Medium"/>
                        </Border>

                        <TextBlock Text="ENDEREÇO DO SERVIDOR (API)" Foreground="{StaticResource TextoSecundario}" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBox x:Name="txtIpServidor" Style="{StaticResource ModernInput}" Text="localhost" Margin="0,0,0,15"/>

                        <TextBlock Text="PORTA DA API" Foreground="{StaticResource TextoSecundario}" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBox x:Name="txtPortaServidor" Style="{StaticResource ModernInput}" Text="5000" Margin="0,0,0,10"/>

                        <Button Content="Testar Conexão API" Style="{StaticResource BtnAcao}" Margin="0,0,0,25" Click="BtnTestarHostEaPorta_Click"/>

                        <Separator Background="{StaticResource BordaPrincipal}" Margin="0,0,0,25"/>

                        <TextBlock Text="NOME DO BANCO DE DADOS" Foreground="{StaticResource TextoSecundario}" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBox x:Name="txtNomeDatabase" Style="{StaticResource ModernInput}" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="USUÁRIO DB" Foreground="{StaticResource TextoSecundario}" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBox x:Name="txtUsuarioDatabase" Style="{StaticResource ModernInput}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="PORTA DB" Foreground="{StaticResource TextoSecundario}" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBox x:Name="txtPortaDoBanco" Style="{StaticResource ModernInput}" Text="3306"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="SENHA DO BANCO" Foreground="{StaticResource TextoSecundario}" FontSize="10" FontWeight="Bold" Margin="15,15,0,8"/>
                        <Border Background="#F1F5F9" CornerRadius="8" BorderBrush="{StaticResource BordaPrincipal}" BorderThickness="1" Margin="0,0,0,15">
                            <PasswordBox x:Name="txtSenhaDatabase" Height="42" Background="Transparent" BorderThickness="0" Padding="12,0" VerticalContentAlignment="Center"/>
                        </Border>

                        <Button Content="Testar Banco de Dados" Style="{StaticResource BtnAcao}" Margin="0,0,0,30" Click="BtnTestar_Click"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="SALVAR" Height="50" Background="{StaticResource CorPrimaria}" Foreground="White" FontWeight="Bold" Margin="0,0,5,0" Click="BtnSalvar_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="10"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Grid.Column="1" Content="CANCELAR" Height="50" Background="Transparent" BorderBrush="{StaticResource BordaPrincipal}" BorderThickness="1" Foreground="{StaticResource TextoSecundario}" FontWeight="Bold" Margin="5,0,0,0" Click="BtnCancelar_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="10"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Border>
</Window>