<Window x:Class="PDV_LANCHES.Views.ConfiguracaoServidor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuração de Conexão"
        Height="720" Width="450"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <!-- Estilo padrão para TextBox -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Estilo do container -->
        <Style x:Key="InputBorder" TargetType="Border">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Botões -->
        <Style x:Key="BtnPadrao" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Border Background="#020617"
            CornerRadius="15"
            BorderBrush="#1E293B"
            BorderThickness="2"
            MouseDown="Window_MouseDown">

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="30">

                <!-- ================= SENHA ================= -->
                <StackPanel Name="ParteDaSenhaBasica">
                    <TextBlock Text="Digite a senha para configurar"
                               Foreground="#94A3B8"
                               FontSize="12"
                               Margin="0,0,0,6"/>

                    <Border Style="{StaticResource InputBorder}">
                        <PasswordBox x:Name="senhabasica"
                                     Height="40"
                                     Background="Transparent"
                                     Foreground="White"
                                     BorderThickness="0"
                                     Padding="10,0"/>
                    </Border>

                    <Button Content="Continuar"
                            Style="{StaticResource BtnPadrao}"
                            Click="validaSenhaBasica_Click"/>
                </StackPanel>

                <!-- ================= CONFIGURAÇÃO ================= -->
                <StackPanel Name="ConfiguracaoPara"
                            Visibility="Hidden"
                            Margin="0,0,0,10">

                    <TextBlock Text="CONFIGURAÇÃO DO SERVIDOR"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,10,0,20"
                               HorizontalAlignment="Center"/>

                    <!-- HOST -->
                    <TextBlock Text="Endereço do Servidor" Foreground="#94A3B8" FontSize="12"/>
                    <Border Style="{StaticResource InputBorder}">
                        <TextBox x:Name="txtIpServidor"
                                 Style="{StaticResource InputBox}"
                                 Text="localhost"/>
                    </Border>

                    <!-- PORTA -->
                    <TextBlock Text="Porta" Foreground="#94A3B8" FontSize="12"/>
                    <Border Style="{StaticResource InputBorder}">
                        <TextBox x:Name="txtPortaServidor"
                                 Style="{StaticResource InputBox}"
                                 Text="5000"/>
                    </Border>

                    <Button Content="Testar servidor"
                            Style="{StaticResource BtnPadrao}"
                            Click="BtnTestarHostEaPorta_Click"/>

                    <!-- BANCO -->
                    <TextBlock Text="Nome do Database" Foreground="#94A3B8" FontSize="12"/>
                    <Border Style="{StaticResource InputBorder}">
                        <TextBox x:Name="txtNomeDatabase"
                                 Style="{StaticResource InputBox}"/>
                    </Border>

                    <TextBlock Text="Porta do Banco" Foreground="#94A3B8" FontSize="12"/>
                    <Border Style="{StaticResource InputBorder}">
                        <TextBox x:Name="txtPortaDoBanco"
                                 Style="{StaticResource InputBox}"
                                 Text="3306"/>
                    </Border>

                    <TextBlock Text="Usuário do Banco" Foreground="#94A3B8" FontSize="12"/>
                    <Border Style="{StaticResource InputBorder}">
                        <TextBox x:Name="txtUsuarioDatabase"
                                 Style="{StaticResource InputBox}"/>
                    </Border>

                    <TextBlock Text="Senha do Banco" Foreground="#94A3B8" FontSize="12"/>
                    <Border Style="{StaticResource InputBorder}">
                        <PasswordBox x:Name="txtSenhaDatabase"
                                     Height="40"
                                     Background="Transparent"
                                     Foreground="White"
                                     BorderThickness="0"
                                     Padding="10,0"/>
                    </Border>

                    <Button Content="Testar Banco"
                            Style="{StaticResource BtnPadrao}"
                            Click="BtnTestar_Click"/>

                    <!-- AÇÕES -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Salvar"
                                Height="45"
                                Background="#2563eb"
                                Foreground="White"
                                FontWeight="Bold"
                                Margin="0,0,5,0"
                                Click="BtnSalvar_Click"/>

                        <Button Grid.Column="1"
                                Content="Cancelar"
                                Height="45"
                                Background="Transparent"
                                BorderBrush="#1E293B"
                                BorderThickness="1"
                                Foreground="#94A3B8"
                                Margin="5,0,0,0"
                                Click="BtnCancelar_Click"/>
                    </Grid>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Border>
</Window>
