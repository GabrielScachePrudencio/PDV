<Window x:Class="PDV_LANCHES.Views.EscolhaDeCaixas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestão de Turnos"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" 
        AllowsTransparency="True"
        Background="Transparent" 
        Height="650" Width="950">

    <Window.Resources>
        <SolidColorBrush x:Key="BgPrincipal" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="BgCard" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextoPrincipal" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextoSecundario" Color="#64748B"/>
        <SolidColorBrush x:Key="CorPrimaria" Color="#3B82F6"/>
        <SolidColorBrush x:Key="CorSucesso" Color="#10B981"/>
        <SolidColorBrush x:Key="BordaPrincipal" Color="#E2E8F0"/>
    </Window.Resources>

    <Border Background="{StaticResource BgPrincipal}" CornerRadius="20" BorderBrush="{StaticResource BordaPrincipal}" BorderThickness="1">
        <Grid Margin="35">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button Content="✕" 
                    HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Margin="0,-15,-15,0" Width="40" Height="40"
                    Background="Transparent" Foreground="{StaticResource TextoSecundario}" 
                    FontSize="18" BorderThickness="0" Cursor="Hand" 
                    Click="Sair_Click"/>

            <StackPanel Grid.Row="0" Margin="0,0,0,30">
                <TextBlock Text="Gestão de Caixas" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextoPrincipal}"/>
                <TextBlock Text="Selecione um caixa aberto ou inicie um novo turno operacional para começar as vendas." Foreground="{StaticResource TextoSecundario}" FontSize="14" Margin="0,5,0,0"/>
                <Border Height="4" Background="{StaticResource CorPrimaria}" HorizontalAlignment="Left" Width="60" CornerRadius="2" Margin="0,15,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Background="{StaticResource BgCard}" CornerRadius="16" BorderBrush="{StaticResource BordaPrincipal}" BorderThickness="1" Padding="25" Margin="0,0,0,30">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="1" Opacity="0.05" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="NOVO TURNO" Foreground="{StaticResource CorPrimaria}" FontSize="11" FontWeight="Black" Margin="0,0,0,4" />
                        <TextBlock Text="Qual o montante inicial em caixa?" Foreground="{StaticResource TextoPrincipal}" FontSize="18" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,20,0">
                        <TextBlock Text="VALOR DE ABERTURA (R$)" Foreground="{StaticResource TextoSecundario}" FontSize="10" FontWeight="Bold" Margin="5,0,0,8"/>
                        <Border Background="#F8FAFC" CornerRadius="10" BorderBrush="{StaticResource BordaPrincipal}" BorderThickness="1">
                            <TextBox x:Name="txtValorInicial" Text="0,00" Height="48" Padding="15,0" 
                                     Background="Transparent" Foreground="{StaticResource CorSucesso}" BorderThickness="0"
                                     VerticalContentAlignment="Center" FontSize="20" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <Button Grid.Column="2" Content="ABRIR CAIXA" Height="48" VerticalAlignment="Bottom" 
                            Background="{StaticResource CorPrimaria}" Foreground="White" FontWeight="Bold" FontSize="13" Cursor="Hand" Click="AbrirCaixa_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2" Color="#3B82F6"/>
                        </Button.Effect>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="{StaticResource BgCard}" CornerRadius="16" BorderBrush="{StaticResource BordaPrincipal}" BorderThickness="1" Padding="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="#F8FAFC" CornerRadius="14,14,0,0" Padding="20,15" BorderBrush="{StaticResource BordaPrincipal}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="CAIXAS DISPONÍVEIS E HISTÓRICO RECENTE" Foreground="{StaticResource TextoSecundario}" FontSize="11" FontWeight="Black" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1" x:Name="dgCaixas" Background="Transparent" AutoGenerateColumns="False" 
                              CanUserAddRows="False" RowHeight="60" BorderThickness="0" HeadersVisibility="Column" 
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                              SelectionChanged="dgCaixas_SelectionChanged" Margin="15,5">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextoSecundario}"/>
                                <Setter Property="Padding" Value="10,15"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BordaPrincipal}"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#EFF6FF"/>
                                        <Setter Property="Foreground" Value="{StaticResource CorPrimaria}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding id}" Width="80" IsReadOnly="True"/>

                            <DataGridTemplateColumn Header="OPERADOR / CAIXA" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="32" Height="32" CornerRadius="16" Background="#F1F5F9" Margin="0,0,12,0">
                                                <TextBlock Text="👤" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14"/>
                                            </Border>
                                            <TextBlock Text="{Binding nome}" VerticalAlignment="Center" FontWeight="Medium"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="STATUS" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="12,6" CornerRadius="20" HorizontalAlignment="Left"
                                                Background="#DCFCE7">
                                            <TextBlock Text="{Binding status}" FontSize="11" FontWeight="Bold" Foreground="#166534" TextAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>