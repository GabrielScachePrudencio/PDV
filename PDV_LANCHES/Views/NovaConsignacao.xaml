<Window x:Class="PDV_LANCHES.Views.NovaConsignacao"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowState="Maximized" WindowStyle="None"
        Title="Nova Consignação" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundPrincipal}">

    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundPrincipal" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="BackgroundSecundario" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BackgroundCard" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BackgroundInput" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BordaPrincipal" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="BordaSecundaria" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="TextoPrincipal" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextoSecundario" Color="#475569"/>
        <SolidColorBrush x:Key="TextoTerciario" Color="#64748B"/>
        <SolidColorBrush x:Key="CorPrimaria" Color="#3B82F6"/>
        <SolidColorBrush x:Key="CorSucesso" Color="#22C55E"/>
        <SolidColorBrush x:Key="CorErro" Color="#EF4444"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="110"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,0,10,25">
            <Button x:Name="btnVoltar" Content="X" FontSize="18" Width="45" Height="45" 
                    Background="{StaticResource BackgroundCard}" Foreground="{StaticResource TextoPrincipal}" 
                    BorderThickness="1" BorderBrush="{StaticResource BordaSecundaria}" Cursor="Hand" Click="btnVoltar_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="22"/>
                    </Style>
                </Button.Resources>
            </Button>
            <TextBlock Text="Nova Consignação de Lanches" FontSize="28" FontWeight="ExtraBold" 
                       Foreground="{StaticResource TextoPrincipal}" VerticalAlignment="Center" Margin="15,0,0,0"/>
        </StackPanel>

        <!-- INFORMAÇÕES DO CLIENTE -->
        <Border Grid.Row="1" Background="{StaticResource BackgroundCard}" CornerRadius="12" Padding="20" Margin="10,0,10,20" 
                BorderBrush="{StaticResource CorPrimaria}" BorderThickness="2">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="CPF DO CLIENTE/CONSIGNADO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextoTerciario}" Margin="0,0,0,8"/>
                    <TextBox x:Name="inputCpfCliente" Width="200" Height="45" Padding="12,0" FontSize="15" MaxLength="14" 
                             TextChanged="inputCpfCliente_TextChanged" VerticalContentAlignment="Center" 
                             Background="{StaticResource BackgroundInput}" Foreground="{StaticResource TextoPrincipal}" 
                             BorderBrush="{StaticResource BordaSecundaria}" CaretBrush="{StaticResource TextoPrincipal}"/>
                </StackPanel>

                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="NOME DO RESPONSÁVEL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextoTerciario}" Margin="0,0,0,8"/>
                    <TextBox x:Name="inputNomeCliente" Width="350" Height="45" Padding="12,0" FontSize="15" 
                             VerticalContentAlignment="Center" Background="{StaticResource BackgroundInput}" 
                             Foreground="{StaticResource TextoPrincipal}" BorderBrush="{StaticResource BordaSecundaria}" 
                             CaretBrush="{StaticResource TextoPrincipal}"/>
                </StackPanel>

                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="DATA DE ACERTO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextoTerciario}" Margin="0,0,0,8"/>
                    <DatePicker x:Name="datePickerDataAcerto" Width="200" Height="35" 
                
                VerticalContentAlignment="Center"/>
                </StackPanel>



                <Border x:Name="StatusClienteBox"
        Visibility="Collapsed"
        CornerRadius="10"
        Padding="15"
        Margin="10,15,0,0"
        Background="#FEF2F2"
        BorderBrush="{StaticResource CorErro}"
        BorderThickness="1">

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <TextBlock x:Name="LabelStatusCliente"
                   FontSize="14"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource CorErro}"
                   Margin="0,0,15,0"/>

                        <Button x:Name="btnCriarCliente"
                Content="➕ Criar Cliente"
                Width="140"
                Height="35"
                FontSize="13"
                FontWeight="Bold"
                Background="{StaticResource CorErro}"
                Foreground="White"
                BorderThickness="0"
                Click="btnCriarCliente_Click"
                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                    </StackPanel>
                </Border>

            </StackPanel>
        </Border>

        <!-- ÁREA PRINCIPAL: PRODUTOS E CARRINHO -->
        <Grid Grid.Row="2" Margin="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- LISTA DE PRODUTOS -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ListaProdutos">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="200" Margin="0,0,10,10" Background="{StaticResource BackgroundCard}" 
                                    CornerRadius="12" Padding="12" BorderBrush="{StaticResource BordaPrincipal}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding Nome}" FontSize="14" FontWeight="Bold" 
                                               Foreground="{StaticResource TextoPrincipal}" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding Valor, StringFormat='R$ {0:F2}'}" FontSize="15" 
                                               Foreground="{StaticResource CorPrimaria}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="txtQtd" Text="1" Height="35" 
                                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                 Background="{StaticResource BackgroundInput}" 
                                                 Foreground="{StaticResource TextoPrincipal}" 
                                                 BorderBrush="{StaticResource BordaSecundaria}"/>
                                        <Button Grid.Column="1" Content="ADICIONAR" Margin="5,0,0,0" Height="35"
                                                Background="{StaticResource CorPrimaria}" 
                                                Foreground="White" FontSize="12" FontWeight="Bold"
                                                Click="AdicionarItem_Click" Tag="{Binding ElementName=txtQtd}">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- CARRINHO DE CONSIGNAÇÃO -->
            <Border Grid.Column="1" Margin="10,0,0,0" Background="{StaticResource BackgroundCard}" CornerRadius="12" Padding="15" 
                    BorderBrush="{StaticResource BordaPrincipal}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="LANCHES CONSIGNADOS" FontSize="12" FontWeight="Bold" 
                               Foreground="{StaticResource TextoTerciario}" Margin="0,0,0,15"/>
                    <ListBox x:Name="listCarrinho" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BordaPrincipal}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding NomeProduto}" 
                                                       Foreground="{StaticResource TextoPrincipal}" 
                                                       FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding QuantidadeEnviada, StringFormat='{}{0}x unidades'}" 
                                                       FontSize="11" Foreground="{StaticResource TextoTerciario}" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding PrecoUnitarioAcordado, StringFormat='R$ {0:F2} cada'}" 
                                                       FontSize="11" Foreground="{StaticResource TextoSecundario}" Margin="0,2,0,0"/>
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Margin="0,5,0,0">
                                                <Run Text="Total: R$ " Foreground="{StaticResource TextoSecundario}"/>
                                                <Run Text="{Binding SubTotal, StringFormat='{}{0:F2}', Mode=OneWay}" 
                                                     Foreground="{StaticResource CorPrimaria}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="1" Margin="10,0,0,0" Content="X" 
                                                
                                                Foreground="{StaticResource CorErro}" 
                                                Background="Transparent" BorderThickness="0" 
                                                FontSize="16" Click="RemoverItem_Click" Tag="{Binding}"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- RODAPÉ COM TOTAL E FINALIZAR -->
        <Border Grid.Row="3" Background="{StaticResource BackgroundCard}" CornerRadius="15" Margin="10,15,10,10" Padding="30,0" 
                BorderBrush="{StaticResource BordaPrincipal}" BorderThickness="1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Total em Consignação:" FontSize="16" Foreground="{StaticResource TextoTerciario}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtTotalDisplay" Text="R$ 0,00" FontSize="32" FontWeight="Bold" Foreground="{StaticResource CorPrimaria}" Margin="15,0,0,0"/>
                </StackPanel>

                <Button x:Name="btnFinalizar" Content="GERAR CONSIGNAÇÃO ➔" HorizontalAlignment="Right" Width="250" Height="55" 
                        Background="{StaticResource CorSucesso}" Foreground="White" FontSize="16" FontWeight="ExtraBold" Click="btnFinalizar_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="12"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
