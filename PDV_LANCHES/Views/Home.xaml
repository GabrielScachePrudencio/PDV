<Window x:Class="PDV_LANCHES.Views.Home"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowState="Maximized" WindowStyle="none"
        Title="PDV - Operacional" Height="800" Width="1200" 
        
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundPrincipal}">
    <Window.Resources>
        <!-- ========================================= -->
        <!-- PALETA DE CORES - MODO CLARO -->
        <!-- Altere aqui para mudar o tema -->
        <!-- ========================================= -->

        <!-- CORES PRINCIPAIS -->
        <SolidColorBrush x:Key="BackgroundPrincipal" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="BackgroundSecundario" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BackgroundCard" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BackgroundInput" Color="#F1F5F9"/>

        <!-- CORES DE TEXTO -->
        <SolidColorBrush x:Key="TextoPrincipal" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextoSecundario" Color="#475569"/>
        <SolidColorBrush x:Key="TextoTerciario" Color="#94A3B8"/>

        <!-- CORES DE DESTAQUE -->
        <SolidColorBrush x:Key="CorPrimaria" Color="#22C55E"/>
        <SolidColorBrush x:Key="CorSecundaria" Color="#3B82F6"/>
        <SolidColorBrush x:Key="CorAlerta" Color="#EF4444"/>
        <SolidColorBrush x:Key="CorInfo" Color="#38BDF8"/>

        <!-- BORDAS E DIVISORES -->
        <SolidColorBrush x:Key="Borda" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="BordaHover" Color="#22C55E"/>

        <!-- MENU LATERAL -->
        <SolidColorBrush x:Key="MenuBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="MenuBotaoNormal" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="MenuBotaoHover" Color="#E0F2FE"/>
        <SolidColorBrush x:Key="MenuTextoNormal" Color="#475569"/>
        <SolidColorBrush x:Key="MenuTextoHover" Color="#22C55E"/>

        <!-- CARDS E CONTAINERS -->
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorda" Color="#E2E8F0"/>

        <!-- STATUS E BADGES -->
        <SolidColorBrush x:Key="StatusAtivoFundo" Color="#DCFCE7"/>
        <SolidColorBrush x:Key="StatusAtivoTexto" Color="#16A34A"/>

        <!-- COMBOBOX E DROPDOWNS -->
        <SolidColorBrush x:Key="ComboboxBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ComboboxTexto" Color="#0F172A"/>
        <SolidColorBrush x:Key="ComboboxBorda" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="ComboboxDropdown" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ComboboxDropdownBorda" Color="#E2E8F0"/>

        <!-- ITENS DE PEDIDO -->
        <SolidColorBrush x:Key="ItemPedidoFundo" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="ItemPedidoBorda" Color="#E2E8F0"/>

        <!-- ========================================= -->

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource ComboboxTexto}"/>
            <Setter Property="Background" Value="{StaticResource ComboboxBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ComboboxBorda}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid" SnapsToDevicePixels="True">
                            <ToggleButton x:Name="ToggleButton"
                                  Grid.ColumnSpan="2"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                  Focusable="False"
                                  ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="templateRoot" 
                                        Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                        CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow" 
                                              Grid.Column="1"
                                              Data="M 0 0 L 4 4 L 8 0 Z"
                                              Fill="#94A3B8"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                      IsHitTestVisible="False"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"/>

                            <Popup x:Name="PART_Popup"
                           Placement="Bottom"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                Background="{StaticResource ComboboxDropdown}" 
                                BorderBrush="{StaticResource ComboboxDropdownBorda}"
                                BorderThickness="1"
                                CornerRadius="8"
                                MinWidth="{Binding ActualWidth, ElementName=MainGrid}"
                                Margin="0,4,0,0">
                                    <ScrollViewer MaxHeight="300" SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>

                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="DropDownBorder"
                Property="Height"
                Value="95"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter 
                Property="BorderBrush"
                Value="{StaticResource BordaHover}"/>
                            </Trigger>

                        </ControlTemplate.Triggers>


                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource MenuBotaoNormal}"/>
            <Setter Property="Foreground" Value="{StaticResource MenuTextoNormal}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="12,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource MenuBotaoHover}"/>
                    <Setter Property="Foreground" Value="{StaticResource MenuTextoHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource MenuBackground}" BorderBrush="{StaticResource Borda}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,30,0,20">
                    <Border Width="85" Height="85" CornerRadius="45" BorderBrush="{StaticResource CorPrimaria}" BorderThickness="2" Padding="3" HorizontalAlignment="Center">
                        <Grid>
                            <Ellipse x:Name="CircleMask" Fill="#F1F5F9"/>
                            <Border CornerRadius="45" ClipToBounds="True">
                                <Grid>
                                    <Image x:Name="imgLogoMenu" Stretch="UniformToFill">
                                        <Image.OpacityMask>
                                            <VisualBrush Visual="{Binding ElementName=CircleMask}"/>
                                        </Image.OpacityMask>
                                    </Image>
                                    <TextBlock x:Name="txtLogoPlaceholder" Text="🍴" FontSize="30" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="txtNomeLoja" Text="CARREGANDO..." Foreground="{StaticResource TextoPrincipal}" FontSize="16" FontWeight="ExtraBold" Margin="20,15,20,5" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>

                    <Border Background="{StaticResource StatusAtivoFundo}" CornerRadius="10" HorizontalAlignment="Center" Padding="8,2" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource CorPrimaria}" Margin="0,0,5,0"/>
                            <TextBlock Text="SISTEMA ATIVO" Foreground="{StaticResource StatusAtivoTexto}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource BackgroundInput}" Margin="15,0" CornerRadius="12" Padding="15">
                        <StackPanel>
                            <TextBlock Text="OPERADOR" Foreground="{StaticResource TextoTerciario}" FontSize="10" FontWeight="Bold" Margin="0,0,0,2"/>
                            <TextBlock x:Name="usuarioLogadoHome" Text="CARREGANDO..." Foreground="{StaticResource TextoPrincipal}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>

                            <TextBlock Text="CAIXA / TERMINAL" Foreground="{StaticResource TextoTerciario}" FontSize="10" FontWeight="Bold" Margin="0,0,0,2"/>
                            <TextBlock x:Name="txtTerminalCaixaSelecionadoNome" Text="CARREGANDO..." Foreground="{StaticResource TextoPrincipal}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ID CAIXA:" Foreground="{StaticResource TextoTerciario}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtIdDoCaixa" Text="---" Foreground="{StaticResource CorPrimaria}" FontSize="11" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="0,10" VerticalScrollBarVisibility="Auto">
                    
                    <StackPanel>
                        <Button Style="{StaticResource MenuButtonStyle}" x:Name="novoPedido" Click="novoPedido_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="➕" Margin="0,0,12,0" Foreground="{StaticResource CorPrimaria}" FontSize="16"/>
                                <TextBlock Text="Novo Pedido" FontWeight="SemiBold" Foreground="{StaticResource TextoPrincipal}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MenuButtonStyle}" x:Name="todasAsVendas" Click="todasVendas_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" Margin="0,0,12,0" FontSize="16"/>
                                <TextBlock Text="Todas as Vendas"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MenuButtonStyle}" x:Name="VendasPorCaixa" Click="vendasPorCaixa_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📟" Margin="0,0,12,0" FontSize="16"/>
                                <TextBlock Text="Vendas por Caixa"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MenuButtonStyle}" x:Name="estoque" Click="Estoque_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗄" Margin="0,0,12,0" FontSize="16"/>
                                <TextBlock Text="Estoque"/>
                            </StackPanel>
                        </Button>
                    
                        <Button Style="{StaticResource MenuButtonStyle}" x:Name="consignacao" Click="consignacao_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎒" Margin="0,0,12,0" FontSize="16"/>
                                <TextBlock Text="Consignações"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MenuButtonStyle}" x:Name="todosClientes" Click="todosOsClientes_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🙎‍" Margin="0,0,12,0" FontSize="16"/>
                                <TextBlock Text="Todos os Clientes"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="15,20">
                    <Button Name="voltarHome" Content="⚙ Painel Administrativo" Style="{StaticResource MenuButtonStyle}" Height="40" Margin="0,5" Click="VoltarParaEscolha_Click" Visibility="Collapsed" Background="{StaticResource MenuBotaoNormal}"/>
                    <Button Content="Sair do Sistema" Background="#FEE2E2" Foreground="#DC2626" FontWeight="Bold" Height="42" Click="Sair_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
        Background="{StaticResource CardBackground}"
        CornerRadius="16"
        Padding="25,15"
        BorderBrush="{StaticResource CardBorda}"
        BorderThickness="1"
        Margin="0,0,0,20">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Painel de Atendimento"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextoPrincipal}"/>

                        <TextBlock Text="•"
                       Foreground="{StaticResource TextoTerciario}"
                       Margin="12,0"
                       VerticalAlignment="Center"/>


                    </StackPanel>

                    <TextBlock x:Name="txtDataHoje"
                   Grid.Column="1"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource TextoSecundario}"
                   FontSize="12"/>
                </Grid>
            </Border>


            <Border Grid.Row="1"
        Background="{StaticResource CardBackground}"
        CornerRadius="16"
        Padding="20"
        BorderBrush="{StaticResource CardBorda}"
        BorderThickness="1">

                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- FILTRO STATUS -->
                    <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                        <TextBlock Text="FILTRAR STATUS"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextoTerciario}"
                       Margin="2,0,0,6"/>

                        <ComboBox x:Name="comboStatusFiltro"
                      Width="170"
                      Height="40"
                      Style="{StaticResource DarkComboBox}"
                      SelectionChanged="ComboBox_SelectionChanged"/>
                    </StackPanel>

                    <!-- BUSCA CPF -->
                    <StackPanel Grid.Column="1" Margin="0,0,32,0" VerticalAlignment="Center">
                        <TextBlock Text="BUSCAR CLIENTE (CPF)"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextoTerciario}"
                       Margin="2,0,0,6"/>

                        <Border Background="{StaticResource BackgroundInput}" CornerRadius="8" BorderBrush="{StaticResource Borda}" BorderThickness="1">
                            <TextBox x:Name="txtBuscaCliente"
                         Width="180"
                         Height="40"
                         Background="Transparent"
                         Foreground="{StaticResource TextoPrincipal}"
                         BorderThickness="0"
                         Padding="14,0"
                         VerticalContentAlignment="Center"
                         KeyUp="txtBuscaCliente_KeyUp"/>
                        </Border>
                    </StackPanel>

                    <!-- RESUMO -->
                    <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">

                        <!-- LUCRO -->
                        <StackPanel Margin="20,0" VerticalAlignment="Center">
                            <TextBlock Text="LUCRO DO DIA"
                           FontSize="10"
                           Foreground="{StaticResource TextoTerciario}"
                           HorizontalAlignment="Center"/>

                            <TextBlock x:Name="txtTotalLucro"
                           Text="R$ 0,00"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{StaticResource CorPrimaria}"
                           HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- FATURAMENTO -->
                        <StackPanel Margin="20,0" VerticalAlignment="Center">
                            <TextBlock Text="FATURAMENTO DO DIA"
                           FontSize="10"
                           Foreground="{StaticResource TextoTerciario}"
                           HorizontalAlignment="Center"/>

                            <TextBlock x:Name="txtTotalGeral"
                           Text="R$ 0,00"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextoPrincipal}"
                           HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- QTD VENDAS -->
                        <StackPanel Margin="20,0" VerticalAlignment="Center">
                            <TextBlock Text="QTD DE VENDAS"
                           FontSize="10"
                           Foreground="{StaticResource TextoTerciario}"
                           HorizontalAlignment="Center"/>

                            <TextBlock x:Name="txtQuantidadeVendas"
                           Text="0"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{StaticResource CorInfo}"
                           HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- CAIXA -->
                        <StackPanel Margin="20,0" VerticalAlignment="Center">
                            <TextBlock Text="CAIXA (DINHEIRO)"
                           FontSize="10"
                           Foreground="{StaticResource TextoTerciario}"
                           HorizontalAlignment="Center"/>

                            <TextBlock x:Name="txtTotalDinheiro"
                           Text="R$ 0,00"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{StaticResource CorPrimaria}"
                           HorizontalAlignment="Center"/>
                        </StackPanel>

                    </StackPanel>
                </Grid>
            </Border>



            <ScrollViewer Grid.Row="2" Margin="0,20,0,0" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ListaPedidos">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Background="{StaticResource CardBackground}" CornerRadius="12" Padding="15,8" BorderBrush="{StaticResource CardBorda}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Id, StringFormat='#{0}'}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextoPrincipal}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DataCriacao, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                           FontSize="13"
                                           Foreground="{StaticResource TextoPrincipal}"/>
                                    </StackPanel>

                                    <ComboBox Grid.Column="2" x:Name="comboStatusPedido" IsEnabled="False"
                                      Width="130" Height="32" Margin="5,0"
                                      Style="{StaticResource DarkComboBox}"
                                      Tag="{Binding}"
                                      Loaded="comboStatusPedido_Loaded"
                                      SelectionChanged="ComboBoxPedido_SelectionChanged"
                                      VerticalAlignment="Center"/>

                                    <ComboBox Grid.Column="3" x:Name="comboFormaPagamento" IsEnabled="False"
                                      Width="130" Height="32" Margin="5,0"
                                      Style="{StaticResource DarkComboBox}"
                                      Tag="{Binding}"
                                      Loaded="comboFormaPagamento_Loaded"
                                      SelectionChanged="ComboBoxPedidoFormaDePagamento_SelectionChanged"
                                      VerticalAlignment="Center"/>



                                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="10,0">
                                        <TextBlock Text="{Binding NomeCliente}" FontSize="13" Foreground="{StaticResource TextoPrincipal}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="10,0">
                                        <TextBlock Text="{Binding CpfCliente}" FontSize="12" Foreground="{StaticResource TextoSecundario}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <ItemsControl Grid.Column="6" ItemsSource="{Binding Itens}" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource ItemPedidoFundo}" CornerRadius="6" Padding="6,2" Margin="0,0,5,5" BorderBrush="{StaticResource ItemPedidoBorda}" BorderThickness="1">
                                                    <TextBlock Foreground="{StaticResource TextoPrincipal}" FontSize="11">
                                                    <Run Text="{Binding Quantidade}" FontWeight="Bold" Foreground="{StaticResource CorPrimaria}"/>
                                                    <Run Text="x" FontSize="9"/>
                                                    <Run Text="{Binding NomeProduto}"/>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>



                                    <TextBlock Grid.Column="7" Text="{Binding ValorTotal, StringFormat='R$ {0:F2}'}" 
                           FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextoPrincipal}" 
                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0"/>

                                    <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Click="VerDetalhes_click" Width="32" Height="32" ToolTip="Detalhes" Background="{StaticResource CorSecundaria}" Margin="0,0,5,0">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                            <TextBlock Text="👁" Foreground="White" FontWeight="Bold"/>
                                        </Button>

                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
