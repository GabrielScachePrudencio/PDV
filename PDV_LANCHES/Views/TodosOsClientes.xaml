<Window x:Class="PDV_LANCHES.Views.TodosOsClientes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        WindowStyle="None" WindowState="Maximized"
        Background="{DynamicResource BackgroundPrincipal}" 
        Title="Todos os Clientes" Height="800" Width="1400"
        mc:Ignorable="d">

    <Window.Resources>
        <!-- Cores e estilos herdados da sua tela de consignações -->
        <SolidColorBrush x:Key="BackgroundPrincipal" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="BackgroundSecundario" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextoPrincipal" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextoSecundario" Color="#475569"/>
        <SolidColorBrush x:Key="CorPrimaria" Color="#6366F1"/>
        <SolidColorBrush x:Key="CorSucesso" Color="#10B981"/>
        <SolidColorBrush x:Key="CorSucessoHover" Color="#059669"/>
        <SolidColorBrush x:Key="BackgroundInput" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="BordaSecundaria" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="BordaPrincipal" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextoTerciario" Color="#64748B"/>

        <Style x:Key="ModernPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CorSucesso}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Padding" Value="25,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource CorSucessoHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BackgroundInput}"/>
            <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BordaSecundaria}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Topo com Voltar -->
            <RowDefinition Height="Auto"/>
            <!-- Barra de pesquisa / adicionar -->
            <RowDefinition Height="*"/>
            <!-- Lista de clientes -->
        </Grid.RowDefinitions>

        <!-- BOTÃO VOLTAR PARA HOME -->
        <Grid Grid.Row="0" Margin="0,0,0,25">
            <Button Click="Voltar_Click" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="←" Foreground="{StaticResource CorPrimaria}" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="VOLTAR PARA HOME" Foreground="{StaticResource TextoTerciario}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
            </Button>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="TODOS OS CLIENTES" Foreground="{StaticResource TextoPrincipal}" FontSize="22" FontWeight="ExtraBold"/>
                <Border Height="3" Width="50" Background="{StaticResource CorPrimaria}" HorizontalAlignment="Left" Margin="2,4,0,0" CornerRadius="2"/>
            </StackPanel>
        </Grid>

        <!-- Barra de pesquisa + botão adicionar -->
        <Border Grid.Row="1" Background="{StaticResource BackgroundSecundario}" CornerRadius="16" Padding="20" Margin="0,0,0,20" BorderBrush="{StaticResource BordaPrincipal}" BorderThickness="1">
            <Grid>
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <StackPanel Margin="0,0,15,0">
                        <TextBlock Text="PESQUISAR CLIENTE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextoSecundario}" Margin="0,0,0,8"/>
                        <TextBox x:Name="txtBuscaCliente" Width="250" Height="40" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                    <Button Click="Pesquisar_Click" Width="120" Height="40" Margin="5,20,0,0" Style="{StaticResource ModernPrimaryButton}" Background="{StaticResource CorPrimaria}">
                        <TextBlock Text="🔍 FILTRAR"/>
                    </Button>
                </WrapPanel>

                <Button x:Name="btnAdicionarCliente" Width="220" Style="{StaticResource ModernPrimaryButton}" Click="AdicionarCliente_Click" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➕" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="ADICIONAR CLIENTE" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
        <!-- Lista de clientes -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ListaClientes">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Background="{StaticResource BackgroundSecundario}" CornerRadius="12" Padding="20" BorderBrush="{StaticResource BordaPrincipal}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Id}" Foreground="{StaticResource TextoPrincipal}" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Nome}" Foreground="{StaticResource TextoPrincipal}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding CpfCnpj}" Foreground="{StaticResource TextoTerciario}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding Telefone}" Foreground="{StaticResource TextoTerciario}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{Binding Email}" Foreground="{StaticResource TextoPrincipal}" VerticalAlignment="Center"/>

                                <Button Grid.Column="5" Click="EntrarCliente_Click" Width="80" Height="35" Background="{StaticResource CorSucesso}" ToolTip="Ver Detalhes do Cliente" Cursor="Hand">
                                    <TextBlock Text="ENTRAR" Foreground="White" FontWeight="Bold"/>
                                </Button>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</Window>
