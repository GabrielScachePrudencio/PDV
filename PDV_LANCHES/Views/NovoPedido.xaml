<Window x:Class="PDV_LANCHES.Views.NovoPedido"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowState="Maximized" WindowStyle="none"
        Title="Novo Pedido" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundPrincipal}">
    <Window.Resources>
        <!-- ========================================= -->
        <!-- PALETA DE CORES - MODO CLARO -->
        <!-- ========================================= -->

        <SolidColorBrush x:Key="BackgroundPrincipal" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="BackgroundSecundario" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BackgroundTerciario" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="BackgroundInput" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BackgroundCard" Color="#FFFFFF"/>

        <SolidColorBrush x:Key="BordaPrincipal" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="BordaSecundaria" Color="#CBD5E1"/>

        <SolidColorBrush x:Key="TextoPrincipal" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextoSecundario" Color="#475569"/>
        <SolidColorBrush x:Key="TextoTerciario" Color="#64748B"/>

        <SolidColorBrush x:Key="CorPrimaria" Color="#3B82F6"/>
        <SolidColorBrush x:Key="CorSucesso" Color="#22C55E"/>
        <SolidColorBrush x:Key="CorErro" Color="#EF4444"/>

        <!-- ========================================= -->

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}"/>
            <Setter Property="Background" Value="{StaticResource BackgroundInput}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BordaSecundaria}"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" Background="{StaticResource BackgroundInput}" BorderBrush="{StaticResource BordaSecundaria}" BorderThickness="1" 
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Grid.ColumnSpan="2">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                            <Path HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" Fill="#94A3B8" Data="M 0 0 L 4 4 L 8 0 Z"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" Margin="12,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True">
                                <Border Background="{StaticResource BackgroundSecundario}" BorderBrush="{StaticResource BordaSecundaria}" BorderThickness="1" CornerRadius="8" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ItemsPresenter />
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="110"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,0,10,25">
            <Button x:Name="btnVoltar" Content="" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="45" Height="45" Background="{StaticResource BackgroundCard}" Foreground="{StaticResource TextoPrincipal}" BorderThickness="1" BorderBrush="{StaticResource BordaSecundaria}" Cursor="Hand" Click="btnVoltar_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="22"/>
                    </Style>
                </Button.Resources>
            </Button>
            <TextBlock Text="Finalizar Novo Pedido" FontSize="28" FontWeight="ExtraBold" Foreground="{StaticResource TextoPrincipal}" VerticalAlignment="Center" Margin="15,0,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource BackgroundCard}" CornerRadius="12" Padding="20" Margin="10,0,10,20" BorderBrush="{StaticResource BordaPrincipal}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="CPF DO CLIENTE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextoTerciario}" Margin="0,0,0,8"/>
                    <TextBox x:Name="inputCpfCliente" Width="200" Height="45" Padding="12,0" FontSize="15" MaxLength="14" TextChanged="inputCpfCliente_TextChanged" VerticalContentAlignment="Center" Background="{StaticResource BackgroundInput}" Foreground="{StaticResource TextoPrincipal}" BorderBrush="{StaticResource BordaSecundaria}" CaretBrush="{StaticResource TextoPrincipal}"/>
                </StackPanel>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="NOME DO CLIENTE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextoTerciario}" Margin="0,0,0,8"/>
                    <TextBox x:Name="inputNomeCliente" Width="350" Height="45" Padding="12,0" FontSize="15" VerticalContentAlignment="Center" Background="{StaticResource BackgroundInput}" Foreground="{StaticResource TextoPrincipal}" BorderBrush="{StaticResource BordaSecundaria}" CaretBrush="{StaticResource TextoPrincipal}" />
                </StackPanel>
                <TextBlock x:Name="LabelCPF" VerticalAlignment="Bottom" Margin="0,0,0,10" FontSize="18" FontWeight="Bold" Foreground="{StaticResource CorPrimaria}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="scrollCardapio" Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ListaCardapioItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="220" Margin="0,0,10,10" Background="{StaticResource BackgroundCard}" CornerRadius="12" Padding="12" BorderBrush="{StaticResource BordaPrincipal}" BorderThickness="1">
                                <StackPanel>
                                    <Border CornerRadius="10" ClipToBounds="True" Margin="0,0,0,10">
                                        <Image Source="{Binding pathImg}" Width="180" Height="100" Stretch="UniformToFill"/>
                                    </Border>
                                    <TextBlock Text="{Binding Nome}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextoPrincipal}"/>
                                    <TextBlock Text="{Binding Valor, StringFormat='R$ {0:F2}'}" FontSize="16" Foreground="{StaticResource CorPrimaria}" FontWeight="Bold"/>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding QuantidadeSelecionada}" Height="35" Background="{StaticResource BackgroundInput}" Foreground="{StaticResource TextoPrincipal}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderBrush="{StaticResource BordaSecundaria}"/>
                                        <Button Grid.Column="1" Content="+" Margin="5,0,0,0" Background="{StaticResource CorPrimaria}" Foreground="White" Click="AdicionarItem_Click" Tag="{Binding}"/>
                                    </Grid>


                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border x:Name="panelCarrinho" Grid.Column="1" Margin="10,0,0,0" Background="{StaticResource BackgroundCard}" CornerRadius="12" Padding="15" BorderBrush="{StaticResource BordaPrincipal}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="ITENS DO PEDIDO" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextoTerciario}" Margin="0,0,0,15"/>
                    <ListBox x:Name="listCarrinho" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BordaPrincipal}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding NomeProduto}" Foreground="{StaticResource TextoPrincipal}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Quantidade, StringFormat='{}{0}x unidades'}" FontSize="11" Foreground="{StaticResource TextoTerciario}"/>

                                            <StackPanel Margin="0,5,0,0">
                                                <TextBlock Text="TIPO DE DESCONTO" FontSize="10" Foreground="{StaticResource TextoTerciario}" Margin="0,0,0,4"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,8">
                                                    <RadioButton Content="%" Foreground="{StaticResource TextoPrincipal}" Margin="0,0,15,0"
                                                     GroupName="{Binding DecontoComPorcentagem}"
                                                     Tag="1"
                                                     IsChecked="True" 
                                                     Checked="TipoDesconto_Changed"/>

                                                    <RadioButton Content="R$" Foreground="{StaticResource TextoPrincipal}"
                                                     GroupName="{Binding DecontoComPorcentagem}"
                                                     Tag="0"
                                                     Checked="TipoDesconto_Changed"/>
                                                </StackPanel>
                                                <TextBlock Text="Valor do DESCONTO" FontSize="10" Foreground="{StaticResource TextoTerciario}" Margin="0,0,0,4"/>

                                                <TextBox Text="{Binding Desconto, UpdateSourceTrigger=PropertyChanged}" 
                                                    Height="30" Background="{StaticResource BackgroundInput}" Foreground="{StaticResource TextoPrincipal}" 
                                                    BorderBrush="{StaticResource BordaSecundaria}" VerticalContentAlignment="Center"
                                                    TextChanged="Desconto_TextChanged"/>
                                            </StackPanel>

                                        </StackPanel>
                                        <Button Grid.Column="1" Margin="20,0,0,0" Content="" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource CorErro}" Background="Transparent" BorderThickness="0" FontSize="16" Click="RemoverItem_Click" Tag="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border x:Name="borderResumo" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{StaticResource BackgroundCard}" CornerRadius="15" Padding="40" BorderBrush="{StaticResource CorSucesso}" BorderThickness="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="600" HorizontalAlignment="Center">
                        <StackPanel x:Name="stackResumoItens"/>
                        <Border BorderBrush="{StaticResource BordaPrincipal}" BorderThickness="0,1,0,0" Margin="0,30,0,20"/>
                        <TextBlock Text="FORMA DE PAGAMENTO" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextoTerciario}" Margin="0,0,0,10"/>
                        <ComboBox x:Name="comboPagamento" Style="{StaticResource DarkComboBox}" DisplayMemberPath="Descricao" SelectedValuePath="Id"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource BackgroundCard}" CornerRadius="15" Margin="10,15,10,10" Padding="30,0" BorderBrush="{StaticResource BordaPrincipal}" BorderThickness="1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Total do Pedido:" FontSize="16" Foreground="{StaticResource TextoTerciario}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtTotalDisplay" Text="R$ 0,00" FontSize="32" FontWeight="Bold" Foreground="{StaticResource CorSucesso}" Margin="15,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="buttonSairSemDarBaixa" Content="Dar baixa depois" Visibility="Hidden" Width="200" Height="50" Background="{StaticResource TextoTerciario}" Foreground="White" FontWeight="Bold" Margin="0,0,15,0" Click="ButtonSairSemDarBaixa_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="buttonProximo" Content="PRÓXIMO ➔" Width="220" Height="55" Background="{StaticResource CorSucesso}" Foreground="White" FontSize="16" FontWeight="ExtraBold" Click="Button_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="12"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>