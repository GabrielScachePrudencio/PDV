<Window x:Class="PDV_LANCHES.Views.ClienteView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cadastro de Cliente"
        Height="500"
        Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">

    <Border Margin="20"
            Padding="20"
            CornerRadius="10"
            Background="White"
            BorderBrush="#DDD"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Título -->
            <TextBlock x:Name="txtTitulo"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#333"
                       Margin="0,0,0,20"/>

            <!-- Formulário -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>

                <!-- Nome -->
                <TextBlock Text="Nome:" VerticalAlignment="Center"/>
                <TextBox x:Name="txtNome"
                         Grid.Column="1"
                         Margin="5"/>

                <!-- CPF -->
                <TextBlock Text="CPF/CNPJ:"
                           Grid.Row="1"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="txtCpf"
                         Grid.Row="1"
                         Grid.Column="1"
                         Margin="5"/>

                <!-- Telefone -->
                <TextBlock Text="Telefone:"
                           Grid.Row="2"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="txtTelefone"
                         Grid.Row="2"
                         Grid.Column="1"
                         Margin="5"/>

                <!-- Email -->
                <TextBlock Text="Email:"
                           Grid.Row="3"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="txtEmail"
                         Grid.Row="3"
                         Grid.Column="1"
                         Margin="5"/>

                <!-- Endereço -->
                <TextBlock Text="Endereço:"
                           Grid.Row="4"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="txtEndereco"
                         Grid.Row="4"
                         Grid.Column="1"
                         Margin="5"/>

                <!-- Ativo -->
                <TextBlock Text="Ativo:"
                   Grid.Row="5"
                   VerticalAlignment="Center"/>
                <CheckBox x:Name="chkAtivo"
                  Grid.Row="5"
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  />
                        <!-- Pode vir marcado por padrão -->

            </Grid>

            <!-- Botões -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">

                <Button x:Name="btnSalvar"
                        Content="Salvar"
                        Width="100"
                        Height="35"
                        Margin="5"
                        Background="#4CAF50"
                        Foreground="White"
                        Click="BtnSalvar_Click"/>

                <Button Content="Cancelar"
                        Width="100"
                        Height="35"
                        Margin="5"
                        Background="#E53935"
                        Foreground="White"
                        Click="BtnCancelar_Click"/>
            </StackPanel>

        </Grid>
    </Border>
</Window>
