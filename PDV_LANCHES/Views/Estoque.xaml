<Window x:Class="PDV_LANCHES.Views.Estoque"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowState="Maximized"
        WindowStyle="None"
ResizeMode="NoResize"
        Background="{DynamicResource BackgroundPrincipal}"
        Title="Gerenciamento de Estoque"
        Height="800"
        Width="1400">

    <!-- ===================== RESOURCES ===================== -->
    <Window.Resources>
        <!-- ========================================= -->
        <!-- PALETA DE CORES - MODO CLARO -->
        <!-- ========================================= -->

        <SolidColorBrush x:Key="BackgroundPrincipal" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="BackgroundSecundario" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BackgroundTerciario" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="BackgroundInput" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BackgroundCard" Color="#FFFFFF"/>

        <SolidColorBrush x:Key="BordaPrincipal" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="BordaSecundaria" Color="#CBD5E1"/>

        <SolidColorBrush x:Key="TextoPrincipal" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextoSecundario" Color="#475569"/>
        <SolidColorBrush x:Key="TextoTerciario" Color="#64748B"/>

        <SolidColorBrush x:Key="CorPrimaria" Color="#3B82F6"/>
        <SolidColorBrush x:Key="CorSucesso" Color="#10B981"/>
        <SolidColorBrush x:Key="CorAlerta" Color="#F59E0B"/>
        <SolidColorBrush x:Key="CorErro" Color="#EF4444"/>
        <SolidColorBrush x:Key="CorInfo" Color="#38BDF8"/>

        <SolidColorBrush x:Key="BadgeVenda" Color="#FEE2E2"/>
        <SolidColorBrush x:Key="BadgeVendaTexto" Color="#DC2626"/>
        <SolidColorBrush x:Key="BadgeCompra" Color="#DCFCE7"/>
        <SolidColorBrush x:Key="BadgeCompraTexto" Color="#16A34A"/>
        <SolidColorBrush x:Key="BadgeAjuste" Color="#FEF3C7"/>
        <SolidColorBrush x:Key="BadgeAjusteTexto" Color="#D97706"/>

        <!-- ========================================= -->

        <Style x:Key="ModernPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CorPrimaria}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="25,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="60,40">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- HEADER -->
            <RowDefinition Height="Auto"/>
            <!-- PAINEL LANÇAMENTO -->
            <RowDefinition Height="*"/>
            <!-- CONTEÚDO -->
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,30" MouseLeftButtonDown="TopBar_MouseLeftButtonDown" >
            <StackPanel>
                <TextBlock Text="MOVIMENTAÇÃO E SALDO"
                           Foreground="{StaticResource TextoPrincipal}"
                           FontSize="26"
                           FontWeight="Black"/>
                <Border Height="4"
                        Width="60"
                        Background="{StaticResource CorPrimaria}"
                        Margin="0,8,0,0"
                        CornerRadius="2"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button Content="VOLTAR PARA HOME"
                        Click="Voltar_Click"
                        Style="{StaticResource ModernPrimaryButton}"
                        Background="Transparent"
                        Foreground="{StaticResource TextoPrincipal}"
                        BorderBrush="{StaticResource BordaSecundaria}"
                        BorderThickness="1"
                        Margin="0,0,10,0"/>

                <Button x:Name="btnLancarCompra"
                        Content="+ LANÇAR COMPRA"
                        Click="LancarCompra_Click"
                        Style="{StaticResource ModernPrimaryButton}"
                        Background="{StaticResource CorSucesso}"
                        Height="48"
                        Width="150"/>
            </StackPanel>



        </Grid>


        <Border x:Name="PainelLancamento"
            Grid.Row="1"
            Margin="0,80,0,20"
            Background="{StaticResource BackgroundSecundario}"
            BorderBrush="{StaticResource BordaPrincipal}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="20"
            Visibility="Collapsed">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- COMBO PRODUTOS -->
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Text="Produto" Foreground="{StaticResource TextoTerciario}" FontSize="11"/>
                    <ComboBox x:Name="cbProdutos"
                      Height="38"
                      DisplayMemberPath="Nome"
                      SelectedValuePath="Id"
                      Background="{StaticResource BackgroundInput}"
                      Foreground="{StaticResource TextoPrincipal}"
                      BorderBrush="{StaticResource BordaSecundaria}"/>
                </StackPanel>

                <!-- QUANTIDADE -->
                <StackPanel Grid.Column="1" Margin="0,0,20,0">
                    <TextBlock Text="Quantidade" Foreground="{StaticResource TextoTerciario}" FontSize="11"/>
                    <TextBox x:Name="txtQuantidade"
                     Height="38"
                     Background="{StaticResource BackgroundInput}"
                     Foreground="{StaticResource TextoPrincipal}"
                     BorderBrush="{StaticResource BordaSecundaria}"/>
                </StackPanel>

                <!-- BOTÕES -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Adicionar"
                    Click="Atualizar_Click"
                    Style="{StaticResource ModernPrimaryButton}"
                    Background="{StaticResource CorPrimaria}"
                    Margin="0,0,10,0"/>

                    <Button Content="Cancelar"
                    Click="Cancelar_Click"
                    Style="{StaticResource ModernPrimaryButton}"
                    Background="{StaticResource TextoTerciario}"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
        Background="{StaticResource BackgroundSecundario}"
        CornerRadius="16"
        Padding="20"
        BorderBrush="{StaticResource BordaPrincipal}"
        BorderThickness="1"
        Margin="0,0,0,30">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <!-- TOTAL EM ESTOQUE -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TOTAL EM ESTOQUE" FontSize="10" Foreground="{StaticResource TextoTerciario}"/>
                        <TextBlock x:Name="txtTotalEstoque"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{StaticResource CorSucesso}"/>
                    </StackPanel>

                    <!-- PRODUTOS -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="PRODUTOS" FontSize="10" Foreground="{StaticResource TextoTerciario}"/>
                        <TextBlock x:Name="txtQtdProdutos"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextoPrincipal}"/>
                    </StackPanel>

                    <!-- ESTOQUE BAIXO -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="ESTOQUE BAIXO" FontSize="10" Foreground="{StaticResource TextoTerciario}"/>
                        <TextBlock x:Name="txtEstoqueBaixo"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{StaticResource CorAlerta}"/>
                    </StackPanel>

                    <!-- ENTRADAS HOJE -->
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="ENTRADAS HOJE" FontSize="10" Foreground="{StaticResource TextoTerciario}"/>
                        <TextBlock x:Name="txtEntradasHoje"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{StaticResource CorSucesso}"/>
                    </StackPanel>

                    <!-- SAÍDAS HOJE -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="SAÍDAS HOJE" FontSize="10" Foreground="{StaticResource TextoTerciario}"/>
                        <TextBlock x:Name="txtSaidasHoje"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{StaticResource CorErro}"/>
                    </StackPanel>

                    <!-- ÚLTIMA MOVIMENTAÇÃO -->
                    <StackPanel Grid.Column="5">
                        <TextBlock Text="ÚLTIMA MOV." FontSize="10" Foreground="{StaticResource TextoTerciario}"/>
                        <TextBlock x:Name="txtUltimaMovimentacao"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="{StaticResource CorInfo}"/>
                    </StackPanel>
                </Grid>
            </Border>


            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0" Margin="0,0,40,0">
                    <TextBlock DockPanel.Dock="Top" Text="LOG DE OPERAÇÕES" Foreground="{StaticResource TextoSecundario}" FontWeight="Bold" FontSize="11" Margin="5,0,0,15"/>

                    <ScrollViewer VerticalScrollBarVisibility="Hidden">
                        <ItemsControl x:Name="dgMovimentacoes">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,12" Background="{StaticResource BackgroundCard}" CornerRadius="12" Padding="15" BorderBrush="{StaticResource BordaPrincipal}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border x:Name="TypeBadge" Grid.Column="0" CornerRadius="6" Padding="5" VerticalAlignment="Center">
                                                <TextBlock x:Name="txtTipo" 
                                                       Text="{Binding Tipo}" 
                                                       HorizontalAlignment="Center" 
                                                       FontSize="11" 
                                                       FontWeight="Black"/> 
                                                
                                            </Border>
                                            <Border x:Name="TypeBadge2" Grid.Column="1" CornerRadius="6" Padding="5" VerticalAlignment="Center">
                                                <TextBlock x:Name="txtValorOrigem" 
                                                   Text="{Binding valorOrigem}" 
                                                   HorizontalAlignment="Center" 
                                                   FontSize="11" 
                                                   FontWeight="Black"/>

                                            </Border>

                                            


                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="20,0">
                                                <TextBlock Foreground="{StaticResource TextoPrincipal}">
                                                    <Run Text="{Binding QuantidadeMovimentada}" />
                                                    <Run Text="x" />
                                                    <Run Text="{Binding Produto}" />
                                                </TextBlock>
                                                <TextBlock Foreground="{StaticResource TextoTerciario}" FontSize="11">
                        
                                                 <Run Text="{Binding TipoIdentificadorLabel, Mode=OneWay}" />
                                                    <Run Text=" " />
                                                    <Run Text="{Binding TipoIdentificadorValor, Mode=OneWay}" FontWeight="Bold"/>

                                                 


                        <Run Text=" - "/>
                        <Run Text="{Binding DataMovimentacao, StringFormat='dd/MM/yyyy HH:mm'}"/>
                        <Run Text=" Usuario: "/>
                        <Run Text="{Binding Usuario}" FontWeight="Bold"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="{StaticResource BackgroundTerciario}" CornerRadius="6" Padding="10,5">
                                                    <TextBlock Text="{Binding QuantidadeAntes}" Foreground="{StaticResource TextoTerciario}" FontSize="14" FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock Text="→" Foreground="{StaticResource CorPrimaria}" FontSize="20" FontWeight="Bold" Margin="12,0" VerticalAlignment="Center"/>
                                                <Border Background="{StaticResource CorPrimaria}" CornerRadius="6" Padding="10,5">
                                                    <TextBlock Text="{Binding QuantidadeDepois}" Foreground="White" FontSize="14" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Tipo}" Value="VENDA">
                                            <Setter TargetName="TypeBadge" Property="Background" Value="{StaticResource BadgeVenda}"/>
                                            <Setter TargetName="txtTipo" Property="Foreground" Value="{StaticResource BadgeVendaTexto}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tipo}" Value="COMPRA">
                                            <Setter TargetName="TypeBadge" Property="Background" Value="{StaticResource BadgeCompra}"/>
                                            <Setter TargetName="txtTipo" Property="Foreground" Value="{StaticResource BadgeCompraTexto}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tipo}" Value="AJUSTE">
                                            <Setter TargetName="TypeBadge" Property="Background" Value="{StaticResource BadgeAjuste}"/>
                                            <Setter TargetName="txtTipo" Property="Foreground" Value="{StaticResource BadgeAjusteTexto}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <Border Grid.Column="1" Background="{StaticResource BackgroundCard}" CornerRadius="20" BorderBrush="{StaticResource BordaPrincipal}" BorderThickness="1" Padding="25">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="TOTAL EM ESTOQUE" Foreground="{StaticResource TextoPrincipal}" FontSize="14" FontWeight="Bold" Margin="0,0,0,20"/>

                        <ScrollViewer VerticalScrollBarVisibility="Hidden">
                            <ItemsControl x:Name="dgEstoque">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BordaPrincipal}" BorderThickness="0,0,0,1" Padding="0,15">
                                            <Grid>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding NomeProduto}" Foreground="{StaticResource TextoPrincipal}" FontSize="14" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Unidades disponíveis" Foreground="{StaticResource TextoSecundario}" FontSize="10"/>
                                                </StackPanel>

                                                <Border HorizontalAlignment="Right" Background="{StaticResource BackgroundTerciario}" CornerRadius="8" Padding="12,6">
                                                    <TextBlock Text="{Binding Quantidade}" Foreground="{StaticResource CorSucesso}" FontSize="18" FontWeight="Black" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>