<Window x:Class="PDV_LANCHES.Views.HomeAdministrativo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowState="Maximized" WindowStyle="none"
        Title="Painel Administrativo - Modo Claro" Height="800" Width="1200" 
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundPrincipal}">

    <Window.Resources>
        <!-- ========================================= -->
        <!-- PALETA DE CORES - MODO CLARO -->
        <!-- ========================================= -->

        <SolidColorBrush x:Key="BackgroundPrincipal" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="BackgroundSecundario" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BackgroundTerciario" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="BackgroundCard" Color="#FFFFFF"/>

        <SolidColorBrush x:Key="BordaPrincipal" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="BordaSecundaria" Color="#CBD5E1"/>

        <SolidColorBrush x:Key="TextoPrincipal" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextoSecundario" Color="#475569"/>
        <SolidColorBrush x:Key="TextoTerciario" Color="#64748B"/>

        <SolidColorBrush x:Key="CorPrimaria" Color="#3B82F6"/>
        <SolidColorBrush x:Key="CorSucesso" Color="#22C55E"/>
        <SolidColorBrush x:Key="CorSucessoFundo" Color="#DCFCE7"/>
        <SolidColorBrush x:Key="CorAlerta" Color="#EF4444"/>
        <SolidColorBrush x:Key="CorAlertaFundo" Color="#FEE2E2"/>

        <SolidColorBrush x:Key="MenuHover" Color="#F1F5F9"/>

        <!-- ========================================= -->

        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextoSecundario}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="12,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource MenuHover}"/>
                    <Setter Property="Foreground" Value="{StaticResource CorPrimaria}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="71*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BackgroundCard}" CornerRadius="16" Padding="20" Margin="0,0,0,24" BorderBrush="{StaticResource BordaPrincipal}" BorderThickness="1" Grid.ColumnSpan="2">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="50" Height="50" Background="{StaticResource CorPrimaria}" CornerRadius="12" Margin="0,0,16,0">
                        <TextBlock Text="👤" Foreground="White" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Sistema Administrativo" FontSize="11" Foreground="{StaticResource TextoTerciario}" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="usuarioLogadoHome" Text="Administrador" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextoPrincipal}"/>
                            <Border Background="{StaticResource CorSucessoFundo}" CornerRadius="6" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Sessão Ativa" Foreground="{StaticResource CorSucesso}" FontSize="9" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnVoltarParaEscolha" Content="Voltar" Background="{StaticResource BackgroundTerciario}" Foreground="{StaticResource TextoPrincipal}" 
                            FontWeight="SemiBold" Width="110" Height="40" Margin="0,0,10,0" BorderThickness="0" Click="VoltarParaEscolha_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Name="Sair" Content="Encerrar" Background="{StaticResource CorAlertaFundo}" Foreground="{StaticResource CorAlerta}" 
                            FontWeight="Bold" Width="100" Height="40" BorderThickness="0" Click="Sair_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BackgroundCard}" CornerRadius="16" Margin="0,0,24,0" BorderBrush="{StaticResource BordaPrincipal}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,30,0,20">
                        <Border Width="90" Height="90" CornerRadius="45" BorderBrush="{StaticResource BordaPrincipal}" BorderThickness="2" Padding="4" HorizontalAlignment="Center">
                            <Border CornerRadius="45" ClipToBounds="True" Background="{StaticResource BackgroundTerciario}">
                                <Grid>
                                    <Image x:Name="imgLogoLoja" Stretch="UniformToFill" />
                                    <TextBlock x:Name="txtLogoPlaceholder" Text="🍴" FontSize="35" Foreground="{StaticResource TextoTerciario}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                        </Border>
                        <TextBlock x:Name="txtNomeLoja" Text="NOME DA LOJA" Foreground="{StaticResource TextoPrincipal}" FontSize="14" FontWeight="Black" Margin="15,15,15,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        <Border Height="1" Background="{StaticResource BordaPrincipal}" Margin="40,20,40,10"/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled" Grid.Row="1" >
                        <StackPanel >
                            <Button Style="{StaticResource MenuButtonStyle}" Content="⚙  Configurações Gerais" Click="ConfiguracoesGeraisVA"/>

                            <Button Style="{StaticResource MenuButtonStyle}" Content="🍔  Produtos" Click="ToggleProdutos_Click"/>
                            <StackPanel x:Name="SubMenuProdutos" Visibility="Collapsed" Margin="30,0,0,10">
                                <Button Style="{StaticResource MenuButtonStyle}" Content="•  Todos os Produtos" Click="AllCardapio" Height="35" FontSize="13"/>
                                <Button Style="{StaticResource MenuButtonStyle}" Content="•  Categorias" Click="Categorias_Click" Height="35" FontSize="13"/>
                            </StackPanel>

                            <Button Style="{StaticResource MenuButtonStyle}" Content="📊  Relatórios" Click="AllRelatorio"/>
                            <Button x:Name="btnUsuarios" Style="{StaticResource MenuButtonStyle}" Content="👥  Usuários" Click="AllUsuario"/>

                            <Button Style="{StaticResource MenuButtonStyle}" Content="📄  Fiscal" Click="ToggleFiscal_Click"/>
                            <StackPanel x:Name="SubMenuFiscal" Visibility="Collapsed" Margin="30,0,0,10">
                                <Button Style="{StaticResource MenuButtonStyle}" Content="•  Configuração Fiscal" Click="ConfiguracaoFiscal" Height="35" FontSize="13"/>
                                <Button Style="{StaticResource MenuButtonStyle}" Content="•  Status de Pedidos" Click="StatusPedidos_Click" Height="35" FontSize="13"/>
                                <Button Style="{StaticResource MenuButtonStyle}" Content="•  Formas de Pagamento" Click="FormasPagamento_Click" Height="35" FontSize="13"/>
                            </StackPanel>

                            <Button x:Name="btnBanco" Style="{StaticResource MenuButtonStyle}" Content="💾  Banco de Dados" Click="ConfiguracaoBanco"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource BackgroundCard}" CornerRadius="16" BorderBrush="{StaticResource BordaPrincipal}" BorderThickness="1">
                <ContentControl x:Name="ConteudoConfiguracoes" Margin="0" />
            </Border>
        </Grid>
    </Grid>
</Window>