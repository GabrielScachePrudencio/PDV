<Window x:Class="PDV_LANCHES.Views.NovoUsuario"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cadastrar Novo Usuário" 
        WindowState="Maximized" 
        WindowStyle="None"
        WindowStartupLocation="CenterScreen" 
        Background="{DynamicResource BackgroundPrincipal}">

    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundPrincipal" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="BackgroundSecundario" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BackgroundTerciario" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="BordaPrincipal" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextoPrincipal" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextoSecundario" Color="#475569"/>
        <SolidColorBrush x:Key="TextoTerciario" Color="#64748B"/>
        <SolidColorBrush x:Key="CorPrimaria" Color="#3B82F6"/>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource BackgroundSecundario}"/>
            <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BordaPrincipal}"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="{StaticResource TextoTerciario}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Placement="Bottom">
                                <Border Background="White" BorderBrush="{StaticResource BordaPrincipal}" BorderThickness="1" CornerRadius="8" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ItemsPresenter />
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Background" Value="{StaticResource BackgroundSecundario}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BordaPrincipal}"/>
            <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource BackgroundSecundario}" BorderBrush="{StaticResource BordaPrincipal}" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,60,0,0">
                <Border Width="80" Height="80" CornerRadius="40" Background="{StaticResource CorPrimaria}" HorizontalAlignment="Center">
                    <TextBlock Text="👤" FontSize="35" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
                <TextBlock Text="NOVO CADASTRO" Foreground="{StaticResource TextoPrincipal}" FontSize="16" FontWeight="Black" Margin="0,20,0,0" HorizontalAlignment="Center"/>
                <TextBlock Text="Preencha os dados do funcionário" Foreground="{StaticResource TextoTerciario}" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0"/>

                <Border Height="1" Background="{StaticResource BordaPrincipal}" Margin="40,30"/>

                <StackPanel Margin="30,0">
                    <TextBlock Text="Dica:" FontWeight="Bold" Foreground="{StaticResource TextoSecundario}" Margin="0,0,0,5"/>
                    <TextBlock Text="O e-mail será utilizado como login principal para acesso ao sistema." Foreground="{StaticResource TextoTerciario}" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="80,60">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,40">
                <TextBlock Text="GESTÃO DE EQUIPE" FontSize="12" FontWeight="Black" Foreground="{StaticResource CorPrimaria}" />
                <TextBlock Text="Criar Novo Usuário" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource TextoPrincipal}" Margin="0,8,0,0"/>
                <Border Height="2" Width="60" Background="{StaticResource CorPrimaria}" HorizontalAlignment="Left" Margin="0,15,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" MaxWidth="900" HorizontalAlignment="Left">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="NOME COMPLETO" Foreground="{StaticResource TextoTerciario}" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBox x:Name="txtNome" Style="{StaticResource ModernTextBox}" Margin="0,0,0,25"/>

                        <TextBlock Text="E-MAIL (LOGIN)" Foreground="{StaticResource TextoTerciario}" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBox x:Name="txtEmail" Style="{StaticResource ModernTextBox}" Margin="0,0,0,25"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="NÍVEL DE ACESSO" Foreground="{StaticResource TextoTerciario}" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                        <ComboBox x:Name="cbTipo" Style="{StaticResource ModernComboBox}" Margin="0,0,0,25"/>

                        <TextBlock Text="DEFINIR SENHA" Foreground="{StaticResource TextoTerciario}" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                        <PasswordBox x:Name="txtSenha" Height="45" VerticalContentAlignment="Center">
                            <PasswordBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                    <Setter Property="Background" Value="{StaticResource BackgroundSecundario}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BordaPrincipal}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                </Style>
                            </PasswordBox.Resources>
                        </PasswordBox>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,40,0,0">
                <Button Content="CANCELAR" Width="160" Height="52" Background="Transparent" Foreground="{StaticResource TextoTerciario}" FontWeight="Bold" BorderBrush="{StaticResource BordaPrincipal}" BorderThickness="1" Margin="0,0,20,0" Click="Cancelar_Click" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="12"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="FINALIZAR CADASTRO" Width="240" Height="52" Background="{StaticResource CorPrimaria}" Foreground="White" FontWeight="Black" Click="Cadastrar_Click" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="12"/>
                        </Style>
                    </Button.Resources>
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.1" Color="#3B82F6"/>
                    </Button.Effect>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>