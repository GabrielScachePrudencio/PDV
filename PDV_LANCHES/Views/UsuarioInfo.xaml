<Window x:Class="PDV_LANCHES.Views.UsuarioInfo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Informações do Usuário" 
        WindowState="Maximized" 
        WindowStyle="None"
        WindowStartupLocation="CenterScreen" 
        Background="{DynamicResource BackgroundPrincipal}">

    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundPrincipal" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="BackgroundSecundario" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BordaPrincipal" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextoPrincipal" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextoSecundario" Color="#475569"/>
        <SolidColorBrush x:Key="TextoTerciario" Color="#64748B"/>
        <SolidColorBrush x:Key="CorPrimaria" Color="#3B82F6"/>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource BackgroundSecundario}"/>
            <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BordaPrincipal}"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid">
                            <ToggleButton x:Name="ToggleButton" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow" Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="{StaticResource TextoTerciario}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True">
                                <Border Background="White" BorderBrush="{StaticResource BordaPrincipal}" BorderThickness="1" CornerRadius="8" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ItemsPresenter />
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Background" Value="{StaticResource BackgroundSecundario}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BordaPrincipal}"/>
            <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource BackgroundSecundario}" BorderBrush="{StaticResource BordaPrincipal}" >
            <StackPanel Margin="0,60,0,0">
                <Border Width="100" Height="100" CornerRadius="50" BorderBrush="{StaticResource CorPrimaria}" BorderThickness="3" HorizontalAlignment="Center" Background="#F1F5F9">
                    <TextBlock Text="👤" FontSize="45" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock Text="PERFIL DO USUÁRIO" Foreground="{StaticResource TextoPrincipal}" FontSize="16" FontWeight="Black" Margin="0,20,0,0" HorizontalAlignment="Center" />
                <TextBlock x:Name="txtDataCriacao" Text="Membro desde --/--" Foreground="{StaticResource TextoTerciario}" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0"/>

                <Border Height="1" Background="{StaticResource BordaPrincipal}" Margin="40,40"/>

                <StackPanel Margin="30,0">
                    <TextBlock Text="Status da Conta" FontWeight="Bold" Foreground="{StaticResource TextoSecundario}" FontSize="11" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#22C55E" Margin="0,0,8,0"/>
                        <TextBlock Text="Ativo no Sistema" Foreground="{StaticResource TextoTerciario}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="60,50">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,45">
                <TextBlock Text="GERENCIAMENTO DE ACESSO" FontSize="12" FontWeight="Black" Foreground="{StaticResource CorPrimaria}" />
                <TextBlock Text="Informações da Conta" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource TextoPrincipal}" Margin="0,8,0,0"/>
                <Border Height="3" Width="50" Background="{StaticResource CorPrimaria}" HorizontalAlignment="Left" Margin="0,15,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="400"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="400"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="NOME COMPLETO" Foreground="{StaticResource TextoTerciario}" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBox x:Name="txtNomeUsuario" Style="{StaticResource ModernTextBox}" Margin="0,0,0,25"/>

                            <TextBlock Text="E-MAIL" Foreground="{StaticResource TextoTerciario}" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBox x:Name="txtEmailUsuario" Style="{StaticResource ModernTextBox}" Margin="0,0,0,25"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="TIPO DE USUÁRIO" Foreground="{StaticResource TextoTerciario}" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                            <ComboBox x:Name="cbTipoUsuario" Style="{StaticResource ModernComboBox}" Margin="0,0,0,25"/>

                            <TextBlock Text="ALTERAR SENHA" Foreground="{StaticResource TextoTerciario}" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                            <PasswordBox x:Name="txtSenhaUsuario" Height="45" VerticalContentAlignment="Center">
                                <PasswordBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                        <Setter Property="Background" Value="{StaticResource BackgroundSecundario}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource BordaPrincipal}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                    </Style>
                                </PasswordBox.Resources>
                            </PasswordBox>
                            <TextBlock Text="* Deixe em branco para manter a senha atual" Foreground="{StaticResource TextoTerciario}" FontSize="10" FontStyle="Italic" Margin="2,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,30,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" Content="VOLTAR" Width="180" Height="55" Margin="0,0,20,0" Background="Transparent" Foreground="{StaticResource TextoTerciario}" FontWeight="Bold" BorderBrush="{StaticResource BordaPrincipal}" BorderThickness="1" Cursor="Hand" Click="Voltar_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="12"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="2" x:Name="btnSalvarUsuario" Content="SALVAR ALTERAÇÕES" Width="280" Height="55" Background="{StaticResource CorPrimaria}" Foreground="White" FontWeight="Black" FontSize="15" Cursor="Hand" Click="Salvar_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="12"/>
                        </Style>
                    </Button.Resources>
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.1" Color="#3B82F6"/>
                    </Button.Effect>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>