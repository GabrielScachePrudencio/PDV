<Window x:Class="PDV_LANCHES.Views.EscolhaQualHome"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dashboard de Seleção"
        WindowState="Maximized"
        WindowStyle="None" 
        AllowsTransparency="True"
        Background="#F1F5F9">
    <Window.Resources>
        <SolidColorBrush x:Key="TextoPrincipal" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextoSecundario" Color="#64748B"/>
        <SolidColorBrush x:Key="BgCard" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BordaCard" Color="#E2E8F0"/>

        <Style x:Key="ModuloButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="24">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.05" Color="Black"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="border" Property="Margin" Value="-2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="60">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BgCard}" CornerRadius="20" BorderBrush="{StaticResource BordaCard}" BorderThickness="1" Padding="20" Margin="0,0,0,50">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.03" Color="Black"/>
            </Border.Effect>
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="55" Height="55" Background="#3B82F6" CornerRadius="15" Margin="0,0,15,0">
                        <TextBlock Text="👤" FontSize="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Bem-vindo ao" FontSize="12" Foreground="{StaticResource TextoSecundario}" FontWeight="Medium"/>
                        <TextBlock x:Name="usuarioLogadoHome" Text="Operador do Sistema" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextoPrincipal}"/>
                    </StackPanel>
                </StackPanel>

                <Button HorizontalAlignment="Right" Name="Sair" Content="Encerrar Sessão" Width="160" Height="45" 
                        Background="#FEF2F2" Foreground="#DC2626" FontWeight="Bold" BorderThickness="0" 
                        Cursor="Hand" Click="Sair_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="12"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                <TextBlock Text="O que deseja gerenciar agora?" FontSize="32" FontWeight="Black" Foreground="{StaticResource TextoPrincipal}" 
                           HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="Selecione um dos módulos abaixo para prosseguir." FontSize="16" Foreground="{StaticResource TextoSecundario}" 
                           HorizontalAlignment="Center" Margin="0,0,0,50"/>

                <UniformGrid Columns="2" HorizontalAlignment="Center">

                    <Button Name="irVendas" Width="280" Height="300" Margin="20" 
                            Style="{StaticResource ModuloButtonStyle}" BorderBrush="#22C55E" Click="IrVendas">
                        <StackPanel>
                            <Border Width="100" Height="100" Background="#DCFCE7" CornerRadius="50" Margin="0,0,0,25">
                                <TextBlock Text="🛒" FontSize="50" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="VENDAS PDV" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextoPrincipal}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Frente de caixa e pedidos" FontSize="14" Foreground="{StaticResource TextoSecundario}" HorizontalAlignment="Center" Margin="0,8,0,0"/>

                            <Border Background="#22C55E" CornerRadius="15" Padding="15,5" Margin="0,20,0,0" HorizontalAlignment="Center">
                                <TextBlock Text="ACESSAR AGORA" Foreground="White" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <Button Name="irAdministrativo" Width="280" Height="300" Margin="20" 
                            Style="{StaticResource ModuloButtonStyle}" BorderBrush="#3B82F6" Click="IrAdministrativo">
                        <StackPanel>
                            <Border Width="100" Height="100" Background="#DBEAFE" CornerRadius="50" Margin="0,0,0,25">
                                <TextBlock Text="📊" FontSize="50" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="ADMIN" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextoPrincipal}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Estoque, Equipe e Relatórios" FontSize="14" Foreground="{StaticResource TextoSecundario}" HorizontalAlignment="Center" Margin="0,8,0,0"/>

                            <Border Background="#3B82F6" CornerRadius="15" Padding="15,5" Margin="0,20,0,0" HorizontalAlignment="Center">
                                <TextBlock Text="GERENCIAR" Foreground="White" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </Button>

                </UniformGrid>
            </StackPanel>
        </Grid>
    </Grid>
</Window>